root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
# Money correctness: forbid float/double where decimal is required (enforced in review + analyzers later)
dotnet_diagnostic.CA1305.severity = warning

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{asmdef,unity,prefab,asset,mat}]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Tools/*]
indent_size = 2
