{
  "$comment": "Composite indexes for the queries the functions run. matchmake needs stake+createdAt over the challenge inventory; the sweep needs state+expiresAt and state+answeredAt over matches; the collusion and recent-opponent checks query by account over flat collections (single-field indexes are automatic). Deploy with `firebase deploy --only firestore:indexes`.",
  "indexes": [
    {
      "collectionGroup": "redline_challenges",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "stakeCents", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "state", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "state", "order": "ASCENDING" },
        { "fieldPath": "answeredAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "posterUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "challengerUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_meetings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "aUid", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "redline_meetings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "bUid", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
