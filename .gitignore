# ---------------------------------------------------------------
# Unity generated
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Unity-generated meta files (only takes effect if the
# corresponding asset is also tracked — an ignored parent still wins).
!/[Aa]ssets/**/*.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Visual Studio / Rider / VSCode cache
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Unity regenerates these at the repo ROOT for the Unity project itself.
# Root-anchored on purpose: Backend/sim-core-cs/Redline.Core.csproj and its
# Directory.Build.props are real hand-authored source and were never in
# scope for this rule (it doesn't reach past the repo root), so no
# exception is needed for them.
/*.csproj
/*.sln
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.consulo/

# ---------------------------------------------------------------
# .NET build output (unanchored: catches Backend/sim-core-cs and any future
# hand-authored .NET project alike, so nothing Backend-specific is needed
# in the Node/TypeScript section below)
# ---------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.dll
*.exe
!Assets/**/*.dll
project.lock.json

# ---------------------------------------------------------------
# Node / TypeScript backend (Backend/)
# ---------------------------------------------------------------
node_modules/
Backend/**/node_modules/
Backend/**/lib/
# Backend/tools/lib is the exception: it's committed, prebuilt CLI output so
# Tools/* wrappers run with no separate build step on a fresh clone.
!Backend/tools/lib/
Backend/**/dist/
Backend/**/*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-store/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Firebase Admin SDK service-account key and any other backend secrets.
# The key is placed here by hand (see DevDocs/firebase-setup.md) and never committed.
Backend/.secrets/

# Generated by Tools/deploy-backend: @redline/sim-core + @redline/rating built
# lib/ vendored in so the Cloud Build `npm install` can resolve them.
Backend/functions/vendor/

# ---------------------------------------------------------------
# Python (tooling only)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------
# Secrets & local environment  (money game — never commit these)
# ---------------------------------------------------------------
.env
.env.*

# Signing material. The keystore and its passwords never enter the
# repository; Tools/unity-build reads them from the environment (T-805).
*.keystore
!debug.keystore
*.jks
keystore.properties
appsettings.Development.json
appsettings.Local.json
secrets.json

# Build-time only: BuildScript bakes an emulator host:port here for a `--debug`
# build. A committed copy makes RedlineSession point the Firebase SDK at a dead
# LAN address, so a RELEASE APK silently runs offline. Explicit *.meta line
# because Assets/**/*.meta is force-tracked above.
Assets/Redline/Resources/redline-backend.txt
Assets/Redline/Resources/redline-backend.txt.meta

# ---------------------------------------------------------------
# Build / report artifacts (large, regenerable — the actual submission
# report is committed separately, under submissionDocs/). Case-insensitive:
# covers both the repo-root Artifacts/ build-output folder and Backend's own
# artifacts/ (build intermediates, hammer/simulation reports) regardless of
# the filesystem's case sensitivity.
# ---------------------------------------------------------------
[Aa]rtifacts/
*.csv.gz

# ---------------------------------------------------------------
# Internal workflow / process docs — not part of this repo's tracked
# history (kept on disk locally, never committed here).
# ---------------------------------------------------------------
/DevDocs/
/.claude/
/.mcp.json
/CLAUDE.md

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ---------------------------------------------------------------
# Misc local
# ---------------------------------------------------------------
/private/

# Gradle/CMake native-build scratch for the Android APK (Ninja deps, cmake-API
# cache, compiled .o). Regenerated on every build; nothing here is a source.
/.utmp/

# ---------------------------------------------------------------
# Firebase Unity SDK — 250 MB of DLLs + native libs. Not committed;
# re-import on a fresh clone with `./Tools/import-firebase-sdk`
# (packages: /Users/apple/Downloads/firebase_unity_sdk). Re-import is safe —
# .unitypackage GUIDs are stable, so asset references survive.
# ---------------------------------------------------------------
/Assets/Firebase/**
!/Assets/Firebase/google-services.json
!/Assets/Firebase/google-services.json.meta
/Assets/ExternalDependencyManager/
/Assets/ExternalDependencyManager.meta
/Assets/Editor Default Resources/Firebase/
/Assets/Editor Default Resources/Firebase.meta
/Assets/Plugins/iOS/
/Assets/Plugins/iOS.meta
/Assets/Plugins/tvOS/
/Assets/Plugins/tvOS.meta
/Assets/Plugins/Android/
/Assets/Plugins/Android.meta
/Assets/Plugins/PrimeTween/
/Assets/Plugins/PrimeTween.meta
# TextMesh Pro essentials moved under Plugins but are tracked like any other
# asset, unlike the vendor SDK dumps above. Excluded siblings by name rather
# than blanket-ignoring /Assets/Plugins/ itself: git will not re-include a
# path whose parent directory is excluded, so a blanket rule + negation here
# silently fails on a fresh `git add` even though it looks correct.

# EDM4U-generated local Maven repo for the Firebase Android AARs. Regenerated by
# the Android Resolver (Force Resolve); same re-import story as the SDK above.
/Assets/GeneratedLocalRepo/
/Assets/GeneratedLocalRepo.meta

# MCP for Unity bridge runtime logs
Assets/UnityMCP/Log/

# Unity crash dumps + MCP scene-view captures (never assets)
/mono_crash.mem.*.blob
/Assets/Screenshots/
